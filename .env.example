# Copy to .env and fill in the keys you need. Only secrets and tuning knobs
# live here: which project uses which provider and model is decided in
# projects.json (see projects.example.json).

# --- LLM provider keys ---
# Google Gemini (also needed for native video upload)
# GOOGLE_API_KEY=
# OpenAI
# OPENAI_API_KEY=sk-...
# Anthropic
# ANTHROPIC_API_KEY="sk-"
# DeepSeek (OpenAI-compatible, text-only: video falls back to a metadata report)
# DEEPSEEK_API_KEY=sk-...
# OpenRouter (proxies many models, e.g. qwen/qwen2.5-vl-72b-instruct)
# OPENROUTER_API_KEY="sk-..."
# Alibaba DashScope (Qwen, OpenAI-compatible)
# DASHSCOPE_API_KEY=sk-...

# --- Hugging Face (optional) ---
# Passed to the input-processor container for model downloads. Nothing in the
# current code requires it; leave it unset unless you add a model that does.
# HF_TOKEN=

# --- Input processor tuning (optional) ---
# INPUT_PROCESSOR_LOG_LEVEL=INFO
# INPUT_PROCESSOR_PROJECTS_CONFIG=/config/projects.json
# INPUT_PROCESSOR_PROJECTS_ROOT=/projects
# INPUT_PROCESSOR_VIDEO_SEGMENT_SECONDS=60
# INPUT_PROCESSOR_VIDEO_SPLIT_MIN_MB=12
# INPUT_PROCESSOR_VIDEO_FORCE_SPLIT=false
# INPUT_PROCESSOR_VIDEO_SPLIT_BY_DURATION=true
# INPUT_PROCESSOR_VIDEO_REQUIRE_AUDIO=true
# INPUT_PROCESSOR_VIDEO_CONSOLIDATE=true
# INPUT_PROCESSOR_VIDEO_FRAME_SECONDS=2
# INPUT_PROCESSOR_VIDEO_MAX_FRAMES=20
# INPUT_PROCESSOR_HOST=127.0.0.1
# INPUT_PROCESSOR_PORT=8000

# SHARED CRAWLER CONFIGURATION (used by both generators):
MAX_CRAWL_ITERATIONS=3
MAX_CRAWL_DEPTH=2
MAX_CRAWL_PAGES=50
# Only used when running the crawler server directly (python src/main.py):
# WEB_CRAWLER_HOST=127.0.0.1
# WEB_CRAWLER_PORT=8000

# --- Crawler Authentication ---
# Option 1 (RECOMMENDED): Capture auth state interactively.
#   Run: python web-crawler/capture_auth.py http://your-app-url
#   Then point to the generated file:
# CRAWLER_AUTH_ACTIONS_FILE=auth_actions.json
#
# Option 2: Manual cookies (legacy). JSON array of {name: value} objects:
# CRAWLER_COOKIES=[{"auth_session": "2davkryxdwykhw3nr5fgyvmyi4ix6hbrjlegssx2"}]
CRAWLER_COOKIES=

# Projects are configured in projects.json at the repository root:
#   1. cp projects.example.json projects.json  (and edit it)
#   2. python scripts/sync_projects.py         (writes docker-compose.override.yaml)
#   3. docker compose up -d
