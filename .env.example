# LLM PROVIDER CONFIGURATION:
# Google Gemini
# GOOGLE_API_KEY=
# OpenAI
# OPENAI_API_KEY=sk-...
# Anthropic
# ANTHROPIC_API_KEY="sk-"
# DeepSeek (OpenAI-compatible, V4 models: deepseek-v4-flash / deepseek-v4-pro)
# DEEPSEEK_API_KEY=sk-...
# OpenRouter
# OPENROUTER_API_KEY="sk-"

# SHARED CRAWLER CONFIGURATION (used by both generators):
MAX_CRAWL_ITERATIONS=3
MAX_CRAWL_DEPTH=2
MAX_CRAWL_PAGES=50

# --- Crawler Authentication ---
# Option 1 (RECOMMENDED): Capture auth state interactively.
#   Run: python web-crawler/capture_auth.py http://your-app-url
#   Then point to the generated file:
# CRAWLER_AUTH_ACTIONS_FILE=auth_actions.json
#
# Option 2: Manual cookies (legacy). JSON array of {name: value} objects:
# CRAWLER_COOKIES=[{"auth_session": "2davkryxdwykhw3nr5fgyvmyi4ix6hbrjlegssx2"}]
CRAWLER_COOKIES=

# INPUT PROCESSOR CONFIGURATION:
# Providers are: ["google_genai", "openai", "anthropic", "deepseek", "openrouter"]
INPUT_PROCESSOR_PROVIDER=google_genai
INPUT_PROCESSOR_MODEL=gemini-2.0-flash
# For DeepSeek, set INPUT_PROCESSOR_PROVIDER=deepseek and INPUT_PROCESSOR_MODEL=deepseek-v4-flash or deepseek-v4-pro
# NOTE: DeepSeek V4 is text-only (no vision/multimodal). Video analysis falls back to metadata-only.
#       For full video/visual analysis, use google_genai or openai.
INPUTS_DIR=""
INPUTS_CACHE_DIR=""